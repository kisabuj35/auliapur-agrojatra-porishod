{
    "name": "kisabuj35/auliapur-agrojatra-porishod",
    "type": "project",
    "description": "আউলিয়াপুর অগ্রযাত্রা পরিষদ - ডিজিটাল পোর্টাল ERP মাস্টার ইঞ্জিন",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/BanglaHelper.php"
        ]
    },
    "config": {
        "policy.advisories.block": false,
        "audit": {
            "block": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
